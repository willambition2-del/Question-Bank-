# ==========================================
# Question Bank Platform - Environment Template
# ==========================================

# -----------------
# 1. Database (PostgreSQL)
# -----------------
POSTGRES_DB=question_bank
POSTGRES_USER=
POSTGRES_PASSWORD=
# Prisma URL for backend connection (use postgres container name in docker-compose)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# -----------------
# 2. Redis
# -----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------
# 3. Backend (NestJS)
# -----------------
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PROVIDER_CREDENTIALS_MASTER_KEY=

# -----------------
# 4. Admin Dashboard (Next.js)
# -----------------
# Public URL for the backend (used by browser)
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# Internal URL for backend (used by Next.js server components)
BACKEND_INTERNAL_URL=http://backend:3000/api/v1

# -----------------
# 5. External Services (Optional / Future)
# -----------------
# Google Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
