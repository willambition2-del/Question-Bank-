  chunk           KnowledgeChunk           @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  model           ServiceModel             @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([chunkId, modelId])
  @@index([modelId, dimensions, status])
  @@index([chunkId, status])
}

model FeatureUsagePolicy {
  id               String          @id @default(uuid())
  taskType         ServiceTaskType
  enabled          Boolean         @default(false)
  userDailyLimit   Int             @default(0)
  userMonthlyLimit Int             @default(0)
  globalDailyLimit Int             @default(0)
  maxInputTokens   Int             @default(4096)
  maxOutputTokens  Int             @default(1024)
  maxImages        Int             @default(0)
  maxImageSize     Int             @default(0)
  maxDocumentPages Int             @default(0)
  allowedRoles     Json
  subscriptionTier String?
  cooldownSeconds  Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([taskType, subscriptionTier])
  @@index([taskType, enabled])
}

model ServiceRequestLog {
  id                 String               @id @default(uuid())
  requestId          String               @unique
  idempotencyKey     String?
  userId             String?
  taskType           ServiceTaskType
  routingPolicyId    String?
  selectedModelId    String?
  selectedProviderId String?
  status             ServiceRequestStatus @default(PENDING)
  inputTokenCount    Int                  @default(0)
  outputTokenCount   Int                  @default(0)
  imageCount         Int                  @default(0)
  latencyMs          Int?
  estimatedCost      Decimal              @default(0) @db.Decimal(14, 6)
  fallbackCount      Int                  @default(0)
  errorCode          String?
  cacheHit           Boolean              @default(false)
  knowledgeUsed      Boolean              @default(false)
  promptVersion      Int?
  createdAt          DateTime             @default(now())

  @@unique([userId, idempotencyKey])
  @@index([taskType, createdAt])
  @@index([status, createdAt])
  @@index([selectedProviderId, selectedModelId, createdAt])
}

model ProviderCredentialAudit {
  id             String                        @id @default(uuid())
  providerId     String
  actorId        String
  action         ProviderCredentialAuditAction
  secretLastFour String?
  succeeded      Boolean
  errorCode      String?
  createdAt      DateTime                      @default(now())
  provider       ServiceProvider               @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([actorId, createdAt])
}

// ==========================================
// Added Domains: Support, Announcements, Subscriptions, Settings
// ==========================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model SupportTicket {
  id        String          @id @default(uuid())
  userId    String
  subject   String
  category  String
  status    TicketStatus    @default(OPEN)
  priority  TicketPriority  @default(MEDIUM)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  senderId   String
  content    String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     User          @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([senderId])
}

model SystemAnnouncement {
  id          String           @id @default(uuid())
  title       String
  content     String
  type        AnnouncementType @default(INFO)
  isActive    Boolean          @default(true)
  targetRoles UserRole[]
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([isActive, expiresAt])
}

model UserSubscription {
  id           String               @id @default(uuid())
  userId       String
  planId       String
  status       SubscriptionStatus   @default(ACTIVE)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]

  @@index([userId, status])
}

model PaymentTransaction {
  id             String            @id @default(uuid())
  userId         String
  subscriptionId String?
  amount         Float
  currency       String            @default("USD")
  status         PaymentStatus     @default(PENDING)
  paymentMethod  String?
  reference      String?           @unique
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription   UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

enum AiResetPeriod {
  DAILY
  WEEKLY
  MONTHLY
  NEVER
}

model AiAssistantSetting {
  id               String        @id @default("default")
  enabled          Boolean       @default(false)
  providerId       String?
  modelId          String?
  fallbackModelId  String?
  userMessageLimit Int           @default(20)
  resetPeriod      AiResetPeriod @default(DAILY)
  limitMessage     String        @default("لقد وصلت إلى الحد المسموح للمساعد الذكي.")
  updatedById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model AiUserUsage {
  id           String        @id @default(uuid())
  userId       String
  periodKey    String
  messageCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([periodKey])
  @@index([userId])
}

