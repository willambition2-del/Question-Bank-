generator client {
  provider     = "prisma-client"
  moduleFormat = "cjs"
  output       = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  REVIEWER
  ADMIN
  SUPER_ADMIN
}

enum GradeLevel {
  NINTH
  THIRD_SECONDARY
}

enum CompanionType {
  MALE
  FEMALE
}

enum IdentityProvider {
  GOOGLE
}

enum SourceType {
  MINISTRY_EXAM
  MINISTRY_MODEL
  TEXTBOOK
  TEACHER
  IMPORT
  GENERATED
  OTHER
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

enum QuestionReviewStatus {
  DRAFT
  REVIEW_REQUIRED
  READY
  REJECTED
  ARCHIVED
}

enum ImportFileType {
  CSV
  JSON
  XLSX
  SQLITE
  POSTGRES_DUMP
  ZIP
  PDF
}

enum ImportStatus {
  PENDING
  VALIDATING
  READY_TO_IMPORT
  PROCESSING
  UPLOADED
  ANALYZING
  MAPPING_REQUIRED
  READY_FOR_DRY_RUN
  DRY_RUNNING
  DRY_RUN_COMPLETED
  IMPORTING
  PAUSED
  COMPLETED_WITH_WARNINGS
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

enum QuestionImportMode {
  DRY_RUN
  IMPORT
}

enum QuestionImportApprovalMode {
  OWNER_APPROVED_FULL_IMPORT
}

enum ImportedSourceEntityType {
  SUBJECT
  UNIT
  LESSON
  SOURCE
  PASSAGE
  QUESTION
  OPTION
}

enum QuestionImportRowStatus {
  VALID
  WARNING
  INVALID
  DUPLICATE
  IMPORTED
  UPDATED
  SKIPPED
  REQUIRES_REVIEW
  FAILED
  REVIEW_CONFLICT
}

enum QuestionImportSourceType {
  CSV
  JSON
  XLSX
  SQLITE
  POSTGRES_DUMP
  ZIP
  PDF
  MANUAL
}

enum QuestionImportConflictPolicy {
  SKIP_EXISTING
  CREATE_NEW_VERSION
  UPDATE_MISSING_FIELDS_ONLY
  MERGE_REVIEW_REQUIRED
}

enum QuestionImportRollbackStatus {
  REQUESTED
  COMPLETED
  COMPLETED_WITH_BLOCKS
  BLOCKED_BY_DEPENDENCIES
  FAILED
}

enum QuizScope {
  SUBJECT
  UNIT
  LESSON
  EXAM_MODEL
  RANDOM
  MISTAKES
  WEAKNESS
  SAVED
}

enum QuizAttemptStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum QuizTimingMode {
  NONE
  PER_QUESTION
  TOTAL_TIME
}

enum ExplanationMode {
  AFTER_EACH
  AT_END
  DISABLED
}

enum QuestionOrigin {
  MANUAL
  IMPORTED
  GENERATED
}

enum PointType {
  QUIZ_CORRECT
  QUIZ_COMPLETE
  FAST_ANSWER
  DAILY_TASK
  ACHIEVEMENT
  CHALLENGE_WIN
  STREAK
  ADMIN_ADJUSTMENT
}

enum AchievementCategory {
  QUIZZES
  ACCURACY
  STREAK
  QUESTIONS
  MISTAKES
  CHALLENGES
  SUBJECT_MASTERY
  SPECIAL
}

enum AchievementConditionType {
  QUIZZES_COMPLETED
  CORRECT_ANSWERS
  ANSWERED_QUESTIONS
  CURRENT_STREAK
  MISTAKES_REVIEWED
  CHALLENGES_WON
  SUBJECT_MASTERY
  TOTAL_POINTS
  FAST_ANSWERS
}

enum DailyTaskType {
  ANSWER_QUESTIONS
  CORRECT_ANSWERS
  REVIEW_MISTAKES
  COMPLETE_QUIZ
  COMPLETE_LESSON
  PLAY_CHALLENGE
  WIN_CHALLENGE
  DAILY_QUESTION
}

enum UpdateCategory {
  QUESTIONS
  FEATURES
  COMPETITIONS
  IMPROVEMENTS
  GENERAL
}

enum NotificationType {
  ACHIEVEMENT
  ACHIEVEMENT_UNLOCKED
  DAILY_TASK
  DAILY_REMINDER
  WEAK_SUBJECT
  CHALLENGE
  CHALLENGE_INVITE
  CHALLENGE_RESULT
  UPDATE
  STREAK
  SYSTEM
  RECOMMENDATION
}

enum PushDevicePlatform {
  ANDROID
  IOS
  WEB
}

enum ChallengeMode {
  ONE_VS_ONE
  TWO_VS_TWO
  LIGHTNING
  SURVIVAL
}

enum ChallengeStatus {
  CREATED
  MATCHMAKING
  WAITING
  COUNTDOWN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ChallengeParticipantStatus {
  INVITED
  JOINED
  READY
  PLAYING
  ELIMINATED
  LEFT
  COMPLETED
}

enum ServiceTaskType {
  TEXT_CHAT
  QUESTION_EXPLANATION
  QUESTION_HINT
  ANSWER_REVIEW
  LESSON_SUMMARY
  LESSON_SIMPLIFICATION
  STUDY_ASSISTANT
  IMAGE_QUESTION_ANALYSIS
  IMAGE_OCR
  DOCUMENT_QUESTION_ANSWERING
  MATH_PROBLEM_SOLVING
  QUESTION_GENERATION
  QUIZ_GENERATION
  DISTRACTOR_GENERATION
  ANSWER_EXPLANATION_GENERATION
  WRONG_OPTION_EXPLANATION
  CONTENT_CLASSIFICATION
  CONTENT_MODERATION
  RECOMMENDATION_EXPLANATION
  EMBEDDING_GENERATION
  RERANKING
}

enum ServiceProviderType {
  OPENAI_COMPATIBLE
  GOOGLE_COMPATIBLE
  CUSTOM_HTTP
  NVIDIA
  LOCAL_MODEL
  OTHER
}

enum ServiceProviderAuthType {
  BEARER
  API_KEY_HEADER
  QUERY_PARAMETER
  NONE
}

enum RoutingStrategy {
  PRIORITY
  WEIGHTED
  LOWEST_COST
  LOWEST_LATENCY
  QUALITY_FIRST
  BALANCED
}

enum ServiceHealthStatus {
  HEALTHY
  DEGRADED
  UNAVAILABLE
  DISABLED
  RATE_LIMITED
  CIRCUIT_OPEN
}

enum ServiceRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
  REJECTED
  CANCELLED
}

enum StudyResourceCategory {
  CURRICULUM
  TEXTBOOK
  NOTE
  SUMMARY
  REVIEW
  MODEL
  REFERENCE
  OTHER
}

enum KnowledgeBaseScope {
  GLOBAL
  SUBJECT
  UNIT
  LESSON
  QUESTION_BANK
  ADMIN_PRIVATE
}

enum KnowledgeDocumentStatus {
  UPLOADED
  QUEUED
  EXTRACTING
  OCR_REQUIRED
  OCR_PROCESSING
  CHUNKING
  EMBEDDING
  READY
  PARTIALLY_READY
  FAILED
  ARCHIVED
}

enum KnowledgeEmbeddingStatus {
  PENDING
  READY
  FAILED
}

enum AdminPrivilegeAuditAction {
  CREATED_SUPER_ADMIN
  PROMOTED_SUPER_ADMIN
}

enum ProviderCredentialAuditAction {
  CREATED
  REPLACED
  TEST_SUCCEEDED
  TEST_FAILED
  DISABLED
}

model User {
  id                      String                    @id @default(uuid())
  name                    String
  username                String                    @unique
  phone                   String?                   @unique
  email                   String?                   @unique
  passwordHash            String?
  refreshTokenHash        String?
  lastLoginAt             DateTime?
  tokenVersion            Int                       @default(0)
  passwordChangedAt       DateTime?
  role                    UserRole                  @default(STUDENT)
  companion               CompanionType             @default(MALE)
  schoolName              String?
  governorate             String?
  gradeLevel              GradeLevel?               @default(THIRD_SECONDARY)
  onboardingCompleted     Boolean                   @default(false)
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  createdPassages         ReadingPassage[]          @relation("ReadingPassageCreatedBy")
  reviewedPassages        ReadingPassage[]          @relation("ReadingPassageReviewedBy")
  createdQuestions        Question[]                @relation("QuestionCreatedBy")
  reviewedQuestions       Question[]                @relation("QuestionReviewedBy")
  questionReviews         QuestionReview[]          @relation("QuestionReviewReviewer")
  questionImports         QuestionImportJob[]
  approvedQuestionImports QuestionImportJob[]       @relation("QuestionImportApprovedBy")
  adminPrivilegeAudits    AdminPrivilegeAudit[]
  importRollbacks         QuestionImportRollback[]  @relation("QuestionImportRollbackActor")
  questionExports         QuestionExportAudit[]
  quizAttempts            QuizAttempt[]
  questionProgress        StudentQuestionProgress[]
  lessonProgress          StudentLessonProgress[]
  unitProgress            StudentUnitProgress[]
  subjectProgress         StudentSubjectProgress[]
  savedQuestions          SavedQuestion[]
  dailyActivities         StudentDailyActivity[]
  points                  UserPoints?
  pointTransactions       PointTransaction[]
  achievements            UserAchievement[]
  dailyTasks              UserDailyTask[]
  streak                  UserStreak?
  createdUpdates          AppUpdate[]               @relation("AppUpdateCreatedBy")
  notifications           Notification[]
  pushDevices             PushDevice[]
  createdChallenges       Challenge[]               @relation("ChallengeCreatedBy")
  wonChallenges           Challenge[]               @relation("ChallengeWinner")
  favoriteSubjects        UserSubjectFavorite[]
  challengeEntries        ChallengeParticipant[]
  identities              UserIdentity[]
  supportTickets          SupportTicket[]
  ticketMessages          TicketMessage[]
  createdAnnouncements    SystemAnnouncement[]      @relation("AnnouncementCreatedBy")
  subscriptions           UserSubscription[]
  paymentTransactions     PaymentTransaction[]
  aiUsages                AiUserUsage[]

  @@index([role, isActive])
}

model UserIdentity {
  id             String           @id @default(uuid())
  userId         String
  provider       IdentityProvider
  providerUserId String
  providerEmail  String?
  emailVerified  Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Grade {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  code             GradeLevel?       @unique
  description      String?
  sortOrder        Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  curriculumGrades CurriculumGrade[]
  subjects         Subject[]

  @@index([name, deletedAt])
  @@index([sortOrder, isActive, deletedAt])
}

model Curriculum {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  countryCode      String
  academicYear     String?
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  curriculumGrades CurriculumGrade[]
  subjects         Subject[]

  @@index([countryCode, isActive, deletedAt])
  @@index([name, deletedAt])
}

model CurriculumGrade {
  id           String     @id @default(uuid())
  curriculumId String
  gradeId      String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  grade        Grade      @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  @@unique([curriculumId, gradeId])
  @@index([gradeId, isActive])
}

model StudyResource {
  id            String                @id @default(uuid())
  subjectId     String
  unitId        String?
  lessonId      String?
  title         String
  description   String?
  category      StudyResourceCategory
  fileKey       String
  fileName      String
  mimeType      String
  fileSize      Int
  year          Int?
  sortOrder     Int                   @default(0)
  isPublished   Boolean               @default(false)
  downloadCount Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  subject       Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit          Unit?                 @relation(fields: [unitId], references: [id], onDelete: SetNull)
  lesson        Lesson?               @relation(fields: [lessonId], references: [id], onDelete: SetNull)
}

model Subject {
  id              String           @id @default(uuid())
  curriculumId    String
  gradeId         String
  name            String
  slug            String
  description     String?
  iconKey         String?
  colorHex        String?
  coverImageUrl   String?
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  isPublished     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  curriculum      Curriculum       @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  grade           Grade            @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  units           Unit[]
  lessons         Lesson[]
  readingPassages ReadingPassage[]
  questions       Question[]
  examModels      ExamModel[]
  quizAttempts    QuizAttempt[]

  studentProgress StudentSubjectProgress[]
  savedQuestions  SavedQuestion[]
  challenges      Challenge[]
  studyResources  StudyResource[]
  favoritedBy     UserSubjectFavorite[]

  @@unique([curriculumId, gradeId, slug])
  @@index([curriculumId, gradeId, sortOrder])
  @@index([isActive, isPublished, deletedAt])
  @@index([name])
}

model Unit {
  quizAttempts    QuizAttempt[]
  id              String                @id @default(uuid())
  subjectId       String
  name            String
  slug            String
  description     String?
  sortOrder       Int                   @default(0)
  isActive        Boolean               @default(true)
  isPublished     Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  subject         Subject               @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  lessons         Lesson[]
  questions       Question[]
  studentProgress StudentUnitProgress[]
  savedQuestions  SavedQuestion[]
  challenges      Challenge[]
  studyResources  StudyResource[]

  @@unique([subjectId, slug])
  @@index([subjectId, sortOrder])
  @@index([subjectId, isActive, isPublished, deletedAt])
}

model Lesson {
  id              String                  @id @default(uuid())
  subjectId       String
  unitId          String
  name            String
  slug            String
  description     String?
  summary         String?
  sortOrder       Int                     @default(0)
  isActive        Boolean                 @default(true)
  isPublished     Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  subject         Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  unit            Unit                    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  questions       Question[]
  quizAttempts    QuizAttempt[]
  studentProgress StudentLessonProgress[]
  savedQuestions  SavedQuestion[]
  challenges      Challenge[]
  studyResources  StudyResource[]

  @@unique([unitId, slug])
  @@index([subjectId, sortOrder])
  @@index([unitId, sortOrder])
  @@index([unitId, isActive, isPublished, deletedAt])
}

model Source {
  id              String           @id @default(uuid())
  name            String
  type            SourceType
  year            Int?
  governorate     String?
  description     String?
  referenceUrl    String?
  isOfficial      Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  readingPassages ReadingPassage[]
  questions       Question[]
  examModels      ExamModel[]

  @@index([type, year])
  @@index([isActive, deletedAt])
  @@index([name])
}

model ReadingPassage {
  id           String              @id @default(uuid())
  subjectId    String
  sourceId     String?
  title        String?
  passageText  String
  languageCode String              @default("ar")
  difficulty   QuestionDifficulty?
  isActive     Boolean             @default(true)
  isPublished  Boolean             @default(false)
  createdById  String?
  reviewedById String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  subject      Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  source       Source?             @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation("ReadingPassageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   User?               @relation("ReadingPassageReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  questions    Question[]

  @@index([subjectId, isActive, isPublished, deletedAt])
  @@index([sourceId])
}

model Question {
  id                  String                    @id @default(uuid())
  subjectId           String
  unitId              String?
  lessonId            String?
  sourceId            String?
  readingPassageId    String?
  type                QuestionType
  questionText        String
  questionImageUrl    String?
  correctBoolean      Boolean?
  hintText            String?
  explanationShort    String?
  explanationDetailed String?
  dangerKeyword       String?
  commonMistake       String?
  difficulty          QuestionDifficulty        @default(MEDIUM)
  reviewStatus        QuestionReviewStatus      @default(DRAFT)
  origin              QuestionOrigin            @default(MANUAL)
  fingerprint         String?
  isTrapQuestion      Boolean                   @default(false)
  isActive            Boolean                   @default(true)
  isPublished         Boolean                   @default(false)
  contentVersion      Int                       @default(1)
  createdById         String?
  reviewedById        String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?
  subject             Subject                   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  unit                Unit?                     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  lesson              Lesson?                   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  source              Source?                   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  readingPassage      ReadingPassage?           @relation(fields: [readingPassageId], references: [id], onDelete: SetNull)
  createdBy           User?                     @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy          User?                     @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  options             QuestionOption[]
  reviews             QuestionReview[]
  examModels          ExamModelQuestion[]
  attemptQuestions    QuizAttemptQuestion[]
  quizAnswers         QuizAnswer[]
  studentProgress     StudentQuestionProgress[]
  savedByStudents     SavedQuestion[]
  challengeQuestions  ChallengeQuestion[]
  challengeAnswers    ChallengeAnswer[]
  sourceReferences    QuestionSourceReference[]

  @@index([subjectId])
  @@index([unitId])
  @@index([lessonId])
  @@index([sourceId])
  @@index([readingPassageId])
  @@index([reviewStatus])
  @@index([difficulty])
  @@index([type])
  @@index([isPublished, isActive, deletedAt])
  @@index([createdAt])
  @@index([fingerprint])
}

model QuestionImportJob {
  id                    String                       @id @default(uuid())
  uploadedById          String?
  fileName              String
  fileUrl               String?
  fileType              ImportFileType
  status                ImportStatus                 @default(PENDING)
  sourceType            QuestionImportSourceType?
  originalFileName      String?
  storagePath           String?
  checksum              String?                      @unique
  mode                  QuestionImportMode           @default(DRY_RUN)
  approvalMode          QuestionImportApprovalMode?
  approvedById          String?
  approvedAt            DateTime?
  conflictPolicy        QuestionImportConflictPolicy @default(SKIP_EXISTING)
  totalRows             Int                          @default(0)
  processedRows         Int                          @default(0)
  validRows             Int                          @default(0)
  invalidRows           Int                          @default(0)
  importedRows          Int                          @default(0)
  updatedRows           Int                          @default(0)
  skippedRows           Int                          @default(0)
  duplicateRows         Int                          @default(0)
  failedRows            Int                          @default(0)
  reviewRows            Int                          @default(0)
  cursor                Int                          @default(0)
  errorFileUrl          String?
  payload               Json
  validationErrors      Json?
  errorSummary          Json?
  settingsJson          Json?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  uploadedBy            User?                        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  approvedBy            User?                        @relation("QuestionImportApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rows                  QuestionImportRow[]
  sourceReferences      QuestionSourceReference[]
  importedSourceRecords ImportedSourceRecord[]
  rollbacks             QuestionImportRollback[]

  @@index([uploadedById, createdAt])
  @@index([status, createdAt])
  @@index([sourceType, createdAt])
  @@index([approvedById, approvedAt])
}

model ImportedSourceRecord {
  id             String                   @id @default(uuid())
  importJobId    String
  sourceChecksum String
  entityType     ImportedSourceEntityType
  sourceRecordId String
  targetRecordId String
  metadataJson   Json?
  createdAt      DateTime                 @default(now())
  importJob      QuestionImportJob        @relation(fields: [importJobId], references: [id], onDelete: Restrict)

  @@unique([sourceChecksum, entityType, sourceRecordId], map: "ImportedSourceRecord_sourceChecksum_entityType_sourceRecordId_k")
  @@index([importJobId, entityType])
  @@index([entityType, targetRecordId])
}

model QuestionImportRow {
  id                    String                  @id @default(uuid())
  importJobId           String
  rowNumber             Int
  sheetName             String?
  externalId            String?
  sourcePayloadJson     Json
  normalizedPayloadJson Json?
  destinationQuestionId String?
  status                QuestionImportRowStatus
  errorCodes            Json?
  warningCodes          Json?
  fingerprint           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  importJob             QuestionImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber, sheetName])
  @@index([importJobId, status, rowNumber])
  @@index([fingerprint])
  @@index([destinationQuestionId])
}

model QuestionSourceReference {
  id             String                   @id @default(uuid())
  questionId     String
  importJobId    String?
  sourceType     QuestionImportSourceType
  sourceFile     String
  sourceRow      Int?
  externalId     String?
  sourceChecksum String
  importedAt     DateTime                 @default(now())
  question       Question                 @relation(fields: [questionId], references: [id], onDelete: Restrict)
  importJob      QuestionImportJob?       @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceChecksum, sourceRow, externalId])
  @@index([questionId, importedAt])
  @@index([importJobId])
  @@index([externalId])
}

model QuestionImportRollback {
  id            String                       @id @default(uuid())
  importJobId   String
  actorId       String
  status        QuestionImportRollbackStatus @default(REQUESTED)
  deletedRows   Int                          @default(0)
  blockedRows   Int                          @default(0)
  blockedReason Json?
  createdAt     DateTime                     @default(now())
  completedAt   DateTime?
  importJob     QuestionImportJob            @relation(fields: [importJobId], references: [id], onDelete: Restrict)
  actor         User                         @relation("QuestionImportRollbackActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([importJobId, createdAt])
  @@index([actorId, createdAt])
}

model AdminPrivilegeAudit {
  id           String                    @id @default(uuid())
  targetUserId String
  action       AdminPrivilegeAuditAction
  previousRole UserRole?
  activated    Boolean
  environment  String
  actorLabel   String
  metadataJson Json?
  createdAt    DateTime                  @default(now())
  targetUser   User                      @relation(fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model QuestionExportAudit {
  id          String   @id @default(uuid())
  actorId     String
  format      String
  rowCount    Int
  filtersJson Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
}

model ExamModel {
  id              String              @id @default(uuid())
  subjectId       String
  sourceId        String?
  title           String
  slug            String              @unique
  year            Int?
  governorate     String?
  description     String?
  durationMinutes Int
  difficulty      QuestionDifficulty  @default(MIXED)
  isOfficial      Boolean             @default(false)
  isPublished     Boolean             @default(false)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?
  subject         Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  source          Source?             @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  questions       ExamModelQuestion[]
  quizAttempts    QuizAttempt[]

  @@index([subjectId, isPublished, deletedAt])
  @@index([sourceId])
  @@index([year, governorate])
  @@index([sortOrder])
}

model ExamModelQuestion {
  id          String    @id @default(uuid())
  examModelId String
  questionId  String
  sortOrder   Int       @default(0)
  points      Decimal   @default(1) @db.Decimal(8, 2)
